# 이 파일을 .env.local 로 복사해서 쓴다. (.env.local은 Git에 올라가지 않는다)

# 저장소 선택: sqlite (길 A, 내 컴퓨터) | supabase (길 B, 클라우드 + 로그인)
DB_PROVIDER=sqlite

# 길 A: SQLite 파일 위치
SQLITE_URL=file:todo.db

# 길 B: Supabase 프로젝트 주소와 공개용(publishable) 키
# 서버 코드에서만 읽는다 (NEXT_PUBLIC_ 이름을 붙이지 않아서 브라우저로 가지 않는다)
# service_role / secret 키는 RLS를 건너뛰므로 이 앱에서는 절대 쓰지 않는다
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
